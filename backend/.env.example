# Copy to .env and fill in. Never commit .env.

# ---------- Server ----------
PORT=4000

# ---------- Database (Neon Postgres) ----------
DATABASE_URL=

# ---------- JWT ----------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
JWT_2FA_SECRET=
JWT_2FA_EXPIRES_IN=15m
# Also signs seller invite links (7 days)
JWT_RESET_SECRET=
JWT_RESET_EXPIRES_IN=5m

# ---------- Email (Resend) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------- ImageKit (seller logos + private KYC documents) ----------
# Dashboard → Developer options → API keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# e.g. https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_ROOT_FOLDER=marketplace

# ---------- Seller admin app (used in seller invite links) ----------
SELLER_ADMIN_URL=http://localhost:3001

# ---------- Seed: initial Platform Admin (npm run db:seed) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PHONE=
# Only used when the account is first created
SEED_ADMIN_PASSWORD=

# ---------- Customer store (storefront) ----------
# Public base URL of the customer store; seller pages are <CUSTOMER_STORE>/seller/<page-url>
# e.g. https://marketplace.platform.com  (defaults to http://localhost:3000 when empty)
CUSTOMER_STORE=

# ---------- CORS ----------
# Frontends allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3002,http://localhost:3001,http://localhost:3000

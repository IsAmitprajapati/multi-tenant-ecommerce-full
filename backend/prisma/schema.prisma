// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  CUSTOMER
  SELLER
  PLATFORM_ADMIN
  DELIVERY_AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  phone            String?
  passwordHash     String     @map("password_hash")
  fullName         String     @map("full_name")
  userType         UserType   @map("user_type")
  status           UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean    @default(false) @map("two_factor-enabled")
  twoFactorSecret  String?    @map("two_factor_secret")
  profileImage     String?    @map("profile_image")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  passwordUpdatedAt DateTime @default(now()) @map("password_updated_at")

  /// Shopper profile extras (storefront My account)
  gender            Gender?
  dateOfBirth       DateTime?      @map("date_of_birth") @db.Date
  /// { topics: { orderUpdates, promotions, priceDrops, newArrivals }, channels: { push, email, sms } }
  notificationPrefs Json?          @map("notification_prefs")
  addresses         Address[]
  notifications     Notification[]

  passwordResetOtps PasswordResetOtp[]
  sessions          UserSession[]

  twoFactorOtps TwoFactorOtp[]

  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  /// Seller users (owner + staff) belong to exactly one seller
  sellerId             String?               @map("seller_id")
  seller               Seller?               @relation("SellerUsers", fields: [sellerId], references: [id], onDelete: SetNull)
  ownedSellers         Seller[]              @relation("SellerOwner")
  createdSellers       Seller[]              @relation("SellerCreatedBy")
  reviewedKycDocuments SellerKycDocument[]
  inventoryAdjustments InventoryAdjustment[]
  productReviews       ProductReview[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]

  @@index([roleId])
  @@index([sellerId])
  @@map("users")
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("password_reset_otps")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel      String?   @map("device_label")
  ipAddress        String?   @map("ip_address")
  refreshTokenHash String    @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  os      String? @map("os")
  device  String? @map("device")
  browser String? @map("browser")

  @@map("user_sessions")
}

model TwoFactorOtp {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")

  attempts   Int       @default(0)
  verifiedAt DateTime?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_otp")
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

/// Access level a role has on a module. Levels are cumulative:
/// NONE < VIEW < EDIT < MANAGE
enum PermissionLevel {
  NONE
  VIEW
  EDIT
  MANAGE
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  /// System roles (Platform Admin) cannot be edited or deleted
  isSystem    Boolean    @default(false) @map("is_system")
  /// Which kind of user this role is for. Assigning the role sets users.user_type.
  userType    UserType   @default(PLATFORM_ADMIN) @map("user_type")
  status      RoleStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// null = platform role or shared seller role (e.g. Seller Admin); set = custom role created by that seller
  sellerId String? @map("seller_id")
  seller   Seller? @relation("SellerRoles", fields: [sellerId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  users       User[]

  @@index([sellerId])
  @@map("roles")
}

model RolePermission {
  id     String          @id @default(cuid())
  roleId String          @map("role_id")
  role   Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Module key, see src/permissions/permissions.constants.ts
  module String
  level  PermissionLevel @default(NONE)

  @@unique([roleId, module])
  @@map("role_permissions")
}

/**
 * ============================ Sellers ============================
 */

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum SellerCreatedVia {
  SELF_SERVICE
  ADMIN_INITIATED
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  HUF
  OTHER
}

enum KycDocumentType {
  AADHAAR
  PAN
  BUSINESS_REGISTRATION_CERTIFICATE
  FSSAI
  OTHER
}

enum KycDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Seller {
  id                  String           @id @default(cuid())
  name                String
  /// Public page: marketplace.platform.com/seller/<slug>
  slug                String           @unique
  /// ImageKit public URL + fileId of the seller logo
  logoUrl             String?          @map("logo_url")
  logoFileId          String?          @map("logo_file_id")
  /// tenant-brand accent color (hex)
  brandColor          String           @map("brand_color")
  status              SellerStatus     @default(PENDING)
  kycStatus           KycStatus        @default(PENDING) @map("kyc_status")
  /// Set when KYC was verified outside the platform (in person / other process)
  kycOfflineReference String?          @map("kyc_offline_reference")
  /// Defaults from the category; adjustable later in Commission & payouts
  commissionRate      Decimal          @map("commission_rate") @db.Decimal(5, 2)
  createdVia          SellerCreatedVia @map("created_via")

  ownerId     String  @map("owner_id")
  owner       User    @relation("SellerOwner", fields: [ownerId], references: [id])
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("SellerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  businessDetails SellerBusinessDetails?
  kycDocuments    SellerKycDocument[]
  users           User[]                 @relation("SellerUsers")
  roles           Role[]                 @relation("SellerRoles")
  /// Top-level product categories this seller sells in (chosen at onboarding)
  categories      SellerCategory[]
  products        Product[]
  brands          Brand[]

  @@index([status])
  @@index([ownerId])
  @@map("sellers")
}

model SellerBusinessDetails {
  id                  String       @id @default(cuid())
  sellerId            String       @unique @map("seller_id")
  seller              Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  legalBusinessName   String       @map("legal_business_name")
  businessType        BusinessType @map("business_type")
  registeredAddress   String       @map("registered_address")
  gstNumber           String?      @map("gst_number")
  panNumber           String?      @map("pan_number")
  contactPersonName   String       @map("contact_person_name")
  contactPersonMobile String       @map("contact_person_mobile")
  contactEmail        String       @map("contact_email")

  @@map("seller_business_details")
}

model SellerKycDocument {
  id           String            @id @default(cuid())
  sellerId     String            @map("seller_id")
  seller       Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documentType KycDocumentType   @map("document_type")
  /// ImageKit private file — only reachable through short-lived signed URLs
  fileId       String            @map("file_id")
  filePath     String            @map("file_path")
  fileName     String            @map("file_name")
  mimeType     String            @map("mime_type")
  status       KycDocumentStatus @default(PENDING)
  reviewedById String?           @map("reviewed_by_id")
  reviewedBy   User?             @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?         @map("reviewed_at")
  uploadedAt   DateTime          @default(now()) @map("uploaded_at")

  @@index([sellerId])
  @@map("seller_kyc_documents")
}

/**
 * ============================ Catalog ============================
 */

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PackageType {
  STANDARD_BAG
  BOX
  ENVELOPE
  FRAGILE
  CUSTOM
}

/// Where a product can be delivered
enum DeliveryScope {
  /// Only where the seller already delivers
  SELLER_PINCODE_ONLY
  /// Seller pincodes + extra pincodes listed on the product
  SPECIFIC_PINCODES
  /// Anywhere in India via courier
  PAN_INDIA
}

enum InventoryAdjustmentReason {
  INITIAL_STOCK
  RESTOCK
  SOLD_VIA_ORDER
  RETURNED
  DAMAGED
  MANUAL_ADJUSTMENT
  OTHER
}

/// Platform product taxonomy (read-only for sellers)
model ProductCategory {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  parentId              String?           @map("parent_id")
  parent                ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children              ProductCategory[] @relation("CategoryTree")
  description           String?
  /// Default commission % for sellers in this (top-level) category
  defaultCommissionRate Decimal?          @map("default_commission_rate") @db.Decimal(5, 2)
  requiresFssai         Boolean           @default(false) @map("requires_fssai")
  /// Small icon for home tiles, menus and the sidebar (ImageKit). Optional — a built-in icon is shown without it.
  iconFileId            String?           @map("icon_file_id")
  iconUrl               String?           @map("icon_url")
  /// Picture for the category page cards (ImageKit). Optional.
  imageFileId           String?           @map("image_file_id")
  imageUrl              String?           @map("image_url")
  isActive              Boolean           @default(true) @map("is_active")
  sortOrder             Int               @default(0) @map("sort_order")
  products              Product[]
  sellerCategories      SellerCategory[]
  homeSections          HomeSection[]     @relation("HomeSectionCategory")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("product_categories")
}

/// GST tax classes by HSN code
model TaxClass {
  id             String    @id @default(cuid())
  hsnCode        String    @map("hsn_code")
  description    String
  gstRatePercent Decimal   @map("gst_rate_percent") @db.Decimal(5, 2)
  isActive       Boolean   @default(true) @map("is_active")
  products       Product[]

  @@unique([hsnCode, gstRatePercent])
  @@map("tax_classes")
}

/// A seller's own brands (private label)
model Brand {
  id        String    @id @default(cuid())
  name      String
  sellerId  String    @map("seller_id")
  seller    Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@unique([sellerId, name])
  @@map("brands")
}

model Product {
  id         String          @id @default(cuid())
  sellerId   String          @map("seller_id")
  seller     Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String          @map("category_id")
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  brandId    String?         @map("brand_id")
  brand      Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)

  title          String
  description    String?
  /// URL handle: /products/<slug> — unique per seller
  slug           String
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  status         ProductStatus @default(ACTIVE)

  sellingPrice   Decimal  @map("selling_price") @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  costPerItem    Decimal? @map("cost_per_item") @db.Decimal(12, 2)
  taxClassId     String   @map("tax_class_id")
  taxClass       TaxClass @relation(fields: [taxClassId], references: [id])

  /// Used only when the product has no variants
  sku               String?
  inventoryQty      Int     @default(0) @map("inventory_qty")
  lowStockThreshold Int     @default(5) @map("low_stock_threshold")

  weightKg          Decimal?      @map("weight_kg") @db.Decimal(8, 3)
  packageType       PackageType   @default(STANDARD_BAG) @map("package_type")
  requiresColdChain Boolean       @default(false) @map("requires_cold_chain")
  deliveryScope     DeliveryScope @default(SELLER_PINCODE_ONLY) @map("delivery_scope")
  deliveryPincodes  String[]      @default([]) @map("delivery_pincodes")
  /// Set by checkout when the first order containing this product is placed.
  /// Once set, the product can never be deleted — only deactivated.
  firstOrderedAt    DateTime?     @map("first_ordered_at")
  /// Kept in step with published reviews (for cards, sorting and the rating filter)
  ratingAvg         Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount       Int           @default(0) @map("rating_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants     ProductVariant[]
  images       ProductImage[]
  adjustments  InventoryAdjustment[]
  homeSections HomeSectionProduct[]
  reviews      ProductReview[]
  cartItems    CartItem[]
  wishlistedBy WishlistItem[]

  @@unique([sellerId, slug])
  @@index([sellerId, status])
  @@index([categoryId])
  @@map("products")
}

/// Each variant has its own price, stock and SKU (authoritative over the base product when present)
model ProductVariant {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Display label, e.g. "1kg" or "256GB · Black"
  name           String
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  inventoryQty   Int      @default(0) @map("inventory_qty")
  sku            String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  adjustments InventoryAdjustment[]
  cartItems   CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// ImageKit
  fileId    String   @map("file_id")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

/// Audit log of every stock change
model InventoryAdjustment {
  id           String                    @id @default(cuid())
  productId    String                    @map("product_id")
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?                   @map("variant_id")
  variant      ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Signed: +50 restock, -2 damaged
  changeQty    Int                       @map("change_qty")
  /// Stock after this change
  resultingQty Int                       @map("resulting_qty")
  reason       InventoryAdjustmentReason
  note         String?
  adjustedById String?                   @map("adjusted_by_id")
  adjustedBy   User?                     @relation(fields: [adjustedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                  @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("inventory_adjustments")
}

/// Which top-level categories a seller sells in
model SellerCategory {
  sellerId   String          @map("seller_id")
  seller     Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String          @map("category_id")
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now()) @map("created_at")

  @@id([sellerId, categoryId])
  @@index([categoryId])
  @@map("seller_categories")
}

// ───────────────────────── Storefront (customer home page) ─────────────────────────

enum BannerDisplayMode {
  /// Rotating slides
  CAROUSEL
  /// Only the first active banner
  SINGLE
}

enum HomeSectionType {
  SHOP_BY_CATEGORY
  PRODUCTS
  /// Row of 1–6 colour tiles (tag + title + link), e.g. collections or campaigns
  PROMO_CARDS
}

enum HomeProductSource {
  /// Biggest discount (compare-at vs selling price)
  DEALS
  LATEST
  /// Most ordered recently (falls back to latest until orders exist)
  TRENDING
  /// Latest products in one category (top-level or sub-category)
  CATEGORY
  /// Hand-picked products
  MANUAL
}

/// Single row (id = "default"): home page settings
model StorefrontSettings {
  id              String            @id @default("default")
  bannerMode      BannerDisplayMode @default(CAROUSEL) @map("banner_mode")
  /// Carousel autoplay interval
  autoplaySeconds Int               @default(5) @map("autoplay_seconds")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  @@map("storefront_settings")
}

model HomeBanner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  ctaLabel    String?   @map("cta_label")
  /// Where the banner goes, e.g. /category/grocery or a full URL
  linkUrl     String?   @map("link_url")
  /// ImageKit (public)
  imageFileId String    @map("image_file_id")
  imageUrl    String    @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  /// Optional schedule
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("home_banners")
}

model HomeSection {
  id           String               @id @default(cuid())
  type         HomeSectionType
  title        String
  subtitle     String?
  /// PRODUCTS sections only
  source       HomeProductSource?
  /// CATEGORY source: the category to show
  categoryId   String?              @map("category_id")
  category     ProductCategory?     @relation("HomeSectionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  /// SHOP_BY_CATEGORY: chosen top-level categories in order (empty = all active)
  categoryIds  String[]             @default([]) @map("category_ids")
  productLimit Int                  @default(12) @map("product_limit")
  /// PROMO_CARDS: [{ tag, title, linkUrl, theme }]
  cards        Json                 @default("[]")
  sortOrder    Int                  @default(0) @map("sort_order")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  products     HomeSectionProduct[]

  @@index([isActive, sortOrder])
  @@map("home_sections")
}

/// MANUAL source: hand-picked products in order
model HomeSectionProduct {
  sectionId String      @map("section_id")
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId String      @map("product_id")
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int         @default(0) @map("sort_order")

  @@id([sectionId, productId])
  @@index([productId])
  @@map("home_section_products")
}

// ───────────────────────── Reviews & ratings ─────────────────────────

enum ReviewStatus {
  PUBLISHED
  /// Hidden by moderation — not shown and not counted
  HIDDEN
}

/// One review per customer per product (editable by its author)
model ProductReview {
  id        String       @id @default(cuid())
  productId String       @map("product_id")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1–5 stars
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@map("product_reviews")
}

// ───────────────────────── Cart ─────────────────────────

/**
 * A signed-in shopper's cart line (guests keep theirs in the browser until they log in)
 */
model CartItem {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String          @map("product_id")
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?         @map("variant_id")
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// variantId or "" — lets the unique key cover products without variants (NULLs never clash in Postgres)
  variantKey    String          @default("") @map("variant_key")
  quantity      Int
  savedForLater Boolean         @default(false) @map("saved_for_later")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([userId, productId, variantKey])
  @@index([userId])
  @@map("cart_items")
}

/// Products a signed-in shopper saved (guests keep theirs in the browser until they log in)
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

// ───────────────────────── Shopper account ─────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// Saved delivery addresses (one can be the default)
model Address {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "Home", "Work" or the shopper's own name for it
  label     String
  fullName  String   @map("full_name")
  phone     String
  /// Flat / house no., building
  line1     String
  locality  String
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

enum NotificationCategory {
  ORDERS
  OFFERS
  ACCOUNT
}

/// In-app notifications shown on the storefront (My account › Notifications)
model Notification {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  title     String
  body      String?
  /// Where tapping it goes, e.g. /account/addresses
  link      String?
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}
